# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Data & trained models (large / regenerable — commit code, not artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models_saved/*
!models_saved/.gitkeep

# results/ IS committed (small CSVs + plots, so metrics/charts show up on GitHub) —
# only the rolling run log is excluded below via the generic *.log rule.
# results/diagnostics/ is ad-hoc investigation scratch work (not produced by any
# pipeline script), not part of the reported results — excluded on purpose.
results/diagnostics/

# Local-only runs of other model families (teammates' packages): never committed, never quoted in docs.
results/_local_scratch/

# Frontend
dashboard/frontend/node_modules/
dashboard/frontend/dist/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
.claude/
*.log

# Generated per-tier plots (one confusion matrix and one ROC figure per pool and tier of every model, written by
# pipelines/run_tier_study.py): ignored, except the XGBoost reference plots of the primary pool 48 (confusion_matrix_<T>f.png, roc_curve_<T>f.png),
# which are tracked. Other models' plots (teammates commit their own) and the comparison-pool plots (confusion_matrix_pool<N>_<T>f.png) stay ignored.
results/plots/*/confusion_matrix_*f*.png
results/plots/*/roc_curve_*f*.png
!results/plots/xgboost/confusion_matrix_[0-9]*f.png
!results/plots/xgboost/roc_curve_[0-9]*f.png

# Screenshots of the dashboard are not kept in the repository, and no script generates one
results/plots/*/dashboard_*.png
